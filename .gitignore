# Dependencies
node_modules/
.pnpm-store/
package-lock.json
yarn.lock

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Env — secrets never enter git
.env
.env.*
!.env.example

# Vercel CLI link metadata
.vercel

# Local scratch data (regenerable)
data/
# Stream-transcript dumps — raw model output and full reasoning traces
.diag/
# The voice lab: 35 MB / 2,300+ files of corpora and extraction artifacts. AGENTS.md always
# described it as gitignored and it was NOT, which mattered because ship.sh stages with
# `git add -A` after `--untracked-files=all` — one ship would have committed the whole lab.
.voice-lab/
# 21st design-context generator output — regenerated on demand, nothing reads it
.21st/
# AI SDK DevTools — complete local prompts, outputs, reasoning, and provider payloads
.devtools/

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
.codex/outreach/*.lock

.agents/handoff/

# Sentry Config File
.env.sentry-build-plugin
