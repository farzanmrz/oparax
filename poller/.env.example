# Copy to .env.local for local runs (never commit real values). See README.md for what
# each key is for and where its Railway-side counterpart comes from.

# Same Supabase project as the app; a worker-local name and service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The app's /api/ingest URL, e.g. https://oparax.ai/api/ingest (or a localhost URL for
# local testing against `pnpm dev` in the app repo).
INGEST_URL=

# Must be byte-identical to the app's INGEST_SECRET (Vercel env) and to ingest/'s own copy.
INGEST_SECRET=

# Slack incoming webhook for the staleness alarm + the delivery-cap alarm.
SLACK_WEBHOOK_URL=

# Honest UA + contact URL, e.g. OparaxBot/0.1 (+https://oparax.ai/bot) — never a browser
# string. Required, no default.
OPARAX_POLLER_USER_AGENT=

# The adaptive retrieval chain's real Tier 2 fallback (#105) -- used automatically for any
# source when a direct fetch fails or looks blocked, not only sources with an explicit
# retrieval override. Unset means Tier 2 is skipped and a failed direct fetch falls to the
# feed/sitemap-derived teaser.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# A separate zone from BRIGHTDATA_ZONE -- Web Unlocker and SERP API are different Bright
# Data products, each its own zone under the same account/API key. Powers Tier 2b (#107):
# the SERP-search fallback tried after Tier 1 (direct) and Tier 2 (Unlocker) both fail.
# Unset means Tier 2b is skipped, same degrade-cleanly pattern as BRIGHTDATA_ZONE above.
BRIGHTDATA_SERP_ZONE=

# Optional tuning (sane defaults if unset — see README "Env vars").
POLLER_TICK_INTERVAL_MS=45000
POLLER_STALE_THRESHOLD_MS=432000000
POLLER_ALARM_COOLDOWN_MS=3600000
POLLER_MAX_NEW_ITEMS_PER_TICK=20
POLLER_OBSERVED_DAILY_CAP=300
POLLER_CAP_CHECK_INTERVAL_MS=300000
