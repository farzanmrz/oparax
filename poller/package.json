{
  "name": "oparax-poller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Railway worker: ticks every 30-60s, polls each desk's onboarded website sources for new items (sitemap/RSS), POSTs deliveries into the app's /api/ingest. Isolated package — zero imports from the app's lib/.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.106.2",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^27.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.2"
}
