{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/network-command-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking network command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|edit|write|exec_command|exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/biome-write-codex.sh",
            "timeout": 15,
            "statusMessage": "Biome: format-on-write"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.codex/hooks/inject-delegation.sh",
            "statusMessage": "subagent roster",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
