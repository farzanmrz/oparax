{
  "skillOverrides": {
    "feature": "name-only",
    "qc": "name-only",
    "ship": "name-only",
    "lint": "name-only"
  },
  "permissions": {
    "allow": [
      "Bash(set -a && . ./.env.local && set +a && curl -s \"$NEXT_PUBLIC_SUPABASE_URL*)"
    ],
    "ask": [
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__tabs_create"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-write.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/feature-flow.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-sync.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-sync.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
