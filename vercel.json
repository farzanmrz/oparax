{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "redirects": [
    {
      "destination": "https://oparax.ai/:path*",
      "has": [
        {
          "type": "host",
          "value": "oparax-farzanmrzs-projects.vercel.app"
        }
      ],
      "permanent": true,
      "source": "/:path*"
    },
    {
      "destination": "https://oparax.ai/:path*",
      "has": [
        {
          "type": "host",
          "value": "oparax.vercel.app"
        }
      ],
      "permanent": true,
      "source": "/:path*"
    }
  ],
  "regions": ["iad1", "sfo1"],
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/feed",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/accounts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/digests",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/credits",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/builds",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/contact",
      "schedule": "0 * * * *"
    }
  ]
}
