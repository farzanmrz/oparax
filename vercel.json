{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/x/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "fluid": true,
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "redirects": [
    {
      "destination": "https://oparax.ai/:path*",
      "has": [
        {
          "type": "host",
          "value": "oparax-farzanmrzs-projects.vercel.app"
        }
      ],
      "permanent": true,
      "source": "/:path*"
    },
    {
      "destination": "https://oparax.ai/:path*",
      "has": [
        {
          "type": "host",
          "value": "oparax.vercel.app"
        }
      ],
      "permanent": true,
      "source": "/:path*"
    }
  ],
  "regions": ["iad1", "sfo1"]
}
